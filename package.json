{
  "name": "baiku",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "css": "tailwindcss -i ./src/css/main.css -o ./src/css/output.css",
    "css:watch": "tailwindcss -i ./src/css/main.css -o ./src/css/output.css --watch",
    "dev": "npm run css && vite",
    "build": "npm run css && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
